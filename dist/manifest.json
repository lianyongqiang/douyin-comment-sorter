{
  "manifest_version": 3,
  "name": "抖音评论排序器",
  "short_name": "评论排序器",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "直接在抖音原生评论区中，按点赞数或回复数整理当前已加载的主评论。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "显示评论排序工具条"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
